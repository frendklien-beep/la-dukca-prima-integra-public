# Portfolio-safe local development example.
# Production environment values are intentionally not represented here.

APP_NAME=La Dukca PRIMA Integra
SERVICE_NAME=la-dukca-prima-integra-backend
APP_VERSION=0.5.0
API_V1_PREFIX=/api/v1

ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

DATA_DIR=data
DATABASE_URL=sqlite+pysqlite:///./data/la_dukca.db
ALLOWED_ORIGINS=http://localhost:5173

# Supply your own development key locally. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Privacy-safe diagnostics remain disabled by default.
AI_DIAGNOSTIC_LOGGING=false
