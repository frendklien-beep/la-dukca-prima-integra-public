APP_NAME=La Dukca PRIMA Integra
SERVICE_NAME=la-dukca-prima-integra-backend
APP_VERSION=0.5.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=false
BUILD_ID=local
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
DATA_DIR=data
DATABASE_URL=sqlite+pysqlite:///./data/la_dukca.db
DATABASE_ECHO=false
DATABASE_BUSY_TIMEOUT_MS=5000
SQLITE_WAL_ENABLED=true
ADMIN_SESSION_COOKIE_NAME=la_dukca_admin_session
ADMIN_SESSION_IDLE_MINUTES=120
ADMIN_SESSION_ABSOLUTE_HOURS=8
ADMIN_REMEMBER_IDLE_HOURS=24
ADMIN_REMEMBER_ABSOLUTE_DAYS=7
ADMIN_MAX_ACTIVE_SESSIONS=3
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://localhost:5173
OPENAI_API_KEY=

# Sprint 3: Dashboard, Settings, Document Management
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SYSTEM_PROMPT_VERSION=la-dukca-system-v2
DOCUMENT_MAX_SIZE_BYTES=104857600
DOCUMENT_MAX_PAGES=500
DOCUMENT_STREAM_CHUNK_BYTES=1048576
DOCUMENT_TEMP_RETENTION_HOURS=24
DEFAULT_ASSISTANT_NAME=Asisten La Dukca
DEFAULT_AI_ENABLED=true
DEFAULT_KNOWLEDGE_BASE_ENABLED=true

# Sprint 4 PDF Processing and Knowledge Base Pipeline
PROCESSING_QUEUE_MAX_SIZE=20
PROCESSING_WORKER_COUNT=1
PROCESSING_JOB_TIMEOUT_SECONDS=300
PROCESSING_RECOVERY_BATCH_SIZE=50
PROCESSING_STALE_AFTER_MINUTES=15

PDF_MIN_TOTAL_EXTRACTED_CHARS=200
PDF_MIN_PAGE_TEXT_CHARS=40
PDF_MAX_LOW_TEXT_PAGE_RATIO=0.50
PDF_MIN_PAGES_WITH_TEXT_RATIO=0.50
PDF_MAX_REPLACEMENT_CHARACTER_RATIO=0.02
PDF_MIN_ALPHABETIC_RATIO=0.20

CHUNK_TARGET_TOKENS=500
CHUNK_MAX_TOKENS=650
CHUNK_MIN_TOKENS=120
CHUNK_OVERLAP_TOKENS=80

EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_ATTEMPTS=3
KNOWLEDGE_PIPELINE_VERSION=kb-v1
INDEX_SCHEMA_VERSION=1

# Sprint 5 Retrieval, Conversation Intelligence, OpenAI Chat
PUBLIC_CHAT_SESSION_HOURS=24
PUBLIC_CHAT_CONTEXT_MESSAGES=12
PUBLIC_CHAT_RATE_LIMIT_PER_MINUTE=10
PUBLIC_CHAT_RATE_LIMIT_BURST=3
CONVERSATION_MAX_INTENTS=5
RETRIEVAL_CANDIDATE_TOP_K=12
RETRIEVAL_FINAL_TOP_K=5
RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=2
RETRIEVAL_MAX_DOCUMENTS=4
RETRIEVAL_MIN_COSINE_SCORE=0.45
RETRIEVAL_EXACT_MATCH_MIN_SCORE=0.40
RETRIEVAL_CONTEXT_MAX_TOKENS=4500
RETRIEVAL_CONTEXT_PER_INTENT_TOKENS=1800
OPENAI_HISTORY_MAX_MESSAGES=6
OPENAI_HISTORY_MAX_TOKENS=1200
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_GENERATION_TIMEOUT_SECONDS=30
OPENAI_GENERATION_MAX_ATTEMPTS=2

# Privacy-safe structured AI diagnostics. Keep false by default.
AI_DIAGNOSTIC_LOGGING=false
